# Google Maps (address → county resolution)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# BatchData — property search, owner lookup, skip trace
# https://batchdata.com → dashboard → API keys
BATCH_DATA_API_KEY=your-batchdata-key

# Google Sheets (optional)
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=

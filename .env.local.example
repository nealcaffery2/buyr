# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# (or the older name) NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Python Scraper (Railway)
NEXT_PUBLIC_SCRAPER_API_URL=https://your-scraper.railway.app
SCRAPER_API_SECRET=your-internal-secret

# Google Maps — server-side (address → county resolution in the scraper)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Google Maps — client-side (Places Autocomplete dropdown in the search bar).
# Create a separate browser-restricted key with "Places API" + "Maps JavaScript
# API" enabled and lock it to your production domain via HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-places-key

# Google Sheets (optional)
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=

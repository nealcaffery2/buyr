# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# (or the older name) NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Python Scraper (Oracle Cloud — scraper.buyrs.app)
NEXT_PUBLIC_SCRAPER_API_URL=https://scraper.buyrs.app
